# Скопируйте этот файл в private/workbot.env.
# Токен не добавляйте в Git. После публикации старого токена перевыпустите его в MAX.
WORKBOT_TOKEN=ВСТАВЬТЕ_НОВЫЙ_ТОКЕН

# Узнать свой числовой ID: python -m workbot identify
WORKBOT_OWNER_IDS=123456789

# Необязательно: разрешить сбор только из перечисленных групп.
# WORKBOT_ALLOWED_CHAT_IDS=-100001,-100002

# false = молчать посторонним в личном чате; true = отвечать «Доступ запрещён».
WORKBOT_DENY_UNAUTHORIZED=false

# Пилотный Long Polling. Допустимо 1–90 секунд.
WORKBOT_POLL_TIMEOUT=30

# Отдельное хранилище исходных MAX media. Не совпадает с production attachments.
# WORKBOT_MEDIA_ROOT=F:\ProLOGData\workbot_media
WORKBOT_MEDIA_MAX_ATTEMPTS=4
WORKBOT_MEDIA_RETRY_BASE_SECONDS=5
